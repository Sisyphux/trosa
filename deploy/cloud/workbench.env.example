# Copy to the user config directory, NOT into the repository:
#   mkdir -p ~/.config/trosa && cp deploy/cloud/workbench.env.example ~/.config/trosa/workbench.env
#   chmod 600 ~/.config/trosa/workbench.env
# This file contains routing metadata only; never add keys or passwords here.
# Keeping it outside the repo means task worktrees and release archives never
# carry the publish switch. The old in-repo path (deploy/cloud/workbench.env)
# is still read for compatibility and prints a migration notice.
#
# Production is reached over plain SSH with the operator's own key. The host
# alias below must exist in ~/.ssh/config (trosa-new → 43.155.211.57, user ubuntu).
# If this line is removed or empty, the scripts still default to trosa-new.
TRADE_OS_SSH_HOST=trosa-new
TRADE_OS_REMOTE_ROOT=/opt/trade-os
TRADE_OS_POSTGRES_ROOT=/opt/trade-os-postgres
TRADE_OS_DATA_DIR=/var/lib/trade-os
TRADE_OS_PUBLIC_URL=https://app.trosa.space
TRADE_OS_SERVICE_NAME=trade-os
TRADE_OS_TUNNEL_SERVICE_NAME=cloudflared
