#!/usr/bin/env bash
# Trosa 正式发布统一入口。
#
# Codex、Qoder、人工、其他 Agent —— 所有发布都走这一个命令：
#   deploy/cloud/trosa-release publish --commit <sha> [--release-id ID] [--allow-destructive-db]
#   deploy/cloud/trosa-release status [--json]
#   deploy/cloud/trosa-release rollback
#
# 设计原则：
# 1. 本机只做"发射 + 轮询"，真正的发布全程在 ECS 上由 release-remote.sh
#    以 setsid 后台任务执行。本机网络中断、Agent 退出后重进，都只是重新
#    轮询同一个 release，不会产生半发布。
# 2. 传输层只走 Alibaba Cloud Assistant RunCommand/DescribeInvocations，绝不
#    使用 SSH、Workbench interactive session 或实例 root 密码。
# 3. 同一个 release 重复执行是幂等的：服务端按 release id + commit 去重，
#    已是生产版本且健康时直接返回 success/already_production。
# 4. 所有输出都是机器可读的：RESULT JSON 包含 release / production /
#    previous / backup / migration / health / rollback 状态与 next_action。
# 5. 发布结果状态机（TROSA_RELEASE_STATE 行 + check 输出）只有五种：
#      submitted  RunCommand 已被 Cloud Assistant 接受，结果未确认
#      checking   正在轮询 ECS 结果
#      success    已确认成功
#      failed     已确认失败/被拒（refused/rolled_back/busy 属 failed 家族，
#                 仍保留各自的 TROSA_RELEASE_* 细分行）
#      unknown    无法确定（轮询失败/超时）——绝不当作发布失败，用 check
#                 --release-id 恢复查询，或重跑同一 publish（幂等）
set -euo pipefail
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=release-env.sh
source "$SCRIPT_DIR/release-env.sh"
ENV_FILE="$(trosa_resolve_workbench_env "$SCRIPT_DIR")"
SOURCE_DIR="${TRADE_OS_SOURCE_DIR:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

usage() {
  cat <<'EOF'
Usage:
  trosa-release publish --commit <sha> [--release-id ID] [--allow-destructive-db]
  trosa-release status [--json]
  trosa-release check --release-id ID [--json]
  trosa-release rollback [--allow-destructive-db]
  trosa-release db-plan [--applied a,b,c] [--changed p1,p2]

publish  把已推送到 GitHub 的 commit 发布为一个明确 release（幂等，可重跑）。
status   查看 production / previous / migration / backup / health 的确定状态。
check    按 release id 恢复查询该 release 的最终状态（发射中断后先跑这个）。
rollback 切回上一个健康 release（数据库 forward-only，不降级 schema）。
db-plan  本地预检本次改动的数据库分类（none/compatible/destructive）。
EOF
}

fail() { printf 'trosa-release: %s\n' "$*" >&2; exit 1; }

[[ -r "$ENV_FILE" ]] || fail "找不到发布配置 $ENV_FILE；请把 workbench.env.example 复制到 $(trosa_config_home)/workbench.env"
trosa_warn_legacy_workbench_env "$ENV_FILE"
# workbench.env 只允许路由元数据；解析仓库根后以其为准。
PROJECT_ROOT="$SOURCE_DIR"
source "$ENV_FILE"
SOURCE_DIR="$PROJECT_ROOT"

: "${TRADE_OS_ECS_REGION:?TRADE_OS_ECS_REGION is required}"
: "${TRADE_OS_ECS_INSTANCE_ID:?TRADE_OS_ECS_INSTANCE_ID is required}"
REMOTE_ROOT="${TRADE_OS_REMOTE_ROOT:-/opt/trade-os}"
SERVICE_NAME="${TRADE_OS_SERVICE_NAME:-trade-os}"
GITHUB_REMOTE="${TRADE_OS_GITHUB_REPOSITORY:-$(git -C "$SOURCE_DIR" remote get-url origin 2>/dev/null || true)}"

case "$GITHUB_REMOTE" in
  https://github.com/*.git) GITHUB_REMOTE="${GITHUB_REMOTE%.git}" ;;
  https://github.com/*) ;;
  git@github.com:*) GITHUB_REMOTE="https://github.com/${GITHUB_REMOTE#git@github.com:}"; GITHUB_REMOTE="${GITHUB_REMOTE%.git}" ;;
  *) fail "发布需要公开 GitHub origin（ECS 直接下载该 commit 归档），当前为：$GITHUB_REMOTE" ;;
esac
GITHUB_REPOSITORY="${GITHUB_REMOTE#https://github.com/}"

# ---- Cloud Assistant：无 SSH、无实例密码 ------------------------------------
# 传输层可通过 TRADE_OS_CLOUD_ASSISTANT_TRANSPORT 覆盖（仅测试钩子；生产不设置，
# 始终走内置 run-cloud-assistant-command.sh）。
CA_TRANSPORT="${TRADE_OS_CLOUD_ASSISTANT_TRANSPORT:-$SCRIPT_DIR/run-cloud-assistant-command.sh}"
ca_exec() {
  bash "$CA_TRANSPORT" \
    "$TRADE_OS_ECS_INSTANCE_ID" "$TRADE_OS_ECS_REGION" "$1"
}

# 发布结果状态机：把服务端原始 status 归一为
# submitted / checking / success / failed / unknown 五种之一。
release_state_for() {
  case "$1" in
    success) printf 'success' ;;
    failed|refused|rolled_back|rollback_failed|busy) printf 'failed' ;;
    in_progress) printf 'checking' ;;
    *) printf 'unknown' ;;
  esac
}

remote_sh_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

cmd=${1:-}
case "$cmd" in
  db-plan)
    shift
    exec python3 "$SOURCE_DIR/tools/release_db_plan.py" "$SOURCE_DIR/migrations" "$@"
    ;;
  status)
    shift
    as_json=0
    for arg in "$@"; do
      case "$arg" in
        --json) as_json=1 ;;
        *) fail "status 未知参数：$arg" ;;
      esac
    done
    # status-remote.sh 已包含 TROSA_DEPLOY_JSON 行；--json 只抽取机器部分。
    output="$(ca_exec "bash '$REMOTE_ROOT/current/deploy/cloud/status-remote.sh'")" || {
      printf '%s\n' "$output" >&2
      fail "无法读取 ECS 状态（Cloud Assistant 失败），production 状态未知——未做任何变更，可稍后重跑 status"
    }
    if [[ "$as_json" == 1 ]]; then
      json_line="$(printf '%s\n' "$output" | grep '^TROSA_DEPLOY_JSON ' | tail -n 1 | sed 's/^TROSA_DEPLOY_JSON //' || true)"
      status_line="$(printf '%s\n' "$output" | grep '^TROSA_MANAGER_STATUS ' | tail -n 1 || true)"
      if [[ -n "$json_line" ]]; then
        printf '%s\n' "$json_line" | python3 -c "
import json,sys
doc=json.load(sys.stdin); doc['manager_status']='$status_line'; print(json.dumps(doc,indent=2,sort_keys=True,ensure_ascii=False))"
      else
        # 旧 release 尚无 DEPLOY_JSON：明确报告未知，而不是猜测。
        python3 -c "
import json
print(json.dumps({'deploy_state':'unknown','reason':'ECS 运行的是旧发布脚本，尚无部署状态账本','manager_status':'$status_line','next_action':'用新机制发布一次后即可获得确定状态'},indent=2,ensure_ascii=False))"
      fi
    else
      printf '%s\n' "$output"
    fi
    ;;
  check)
    # 恢复查询：发射/轮询被打断后，按 release id 只读询问最终状态。
    # 永不改状态；无法确定时明确返回 unknown（不猜、不重试发布）。
    shift
    as_json=0
    CHECK_RELEASE_ID=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --release-id) [[ $# -ge 2 ]] || fail "--release-id 需要一个值"; CHECK_RELEASE_ID=$2; shift 2 ;;
        --json) as_json=1; shift ;;
        *) fail "check 未知参数：$1" ;;
      esac
    done
    case "$CHECK_RELEASE_ID" in ''|*[!A-Za-z0-9._-]*) fail "check 需要合法的 --release-id" ;; esac
    poll_out="$(ca_exec "cat '$REMOTE_ROOT/.last-deploy-result.json' 2>/dev/null; echo; cat '$REMOTE_ROOT/releases/$CHECK_RELEASE_ID/DEPLOY_RESULT.json' 2>/dev/null" 2>/dev/null || true)"
    TROSA_POLL_OUT="$poll_out" python3 - "$CHECK_RELEASE_ID" <<'PY'
import json, os, sys

release_id = sys.argv[1]
best = None
for line in os.environ.get("TROSA_POLL_OUT", "").splitlines():
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        doc = json.loads(line)
    except Exception:
        continue
    # 优先该 release 自己的 DEPLOY_RESULT.json（输入中的第二份）。
    if doc.get("release") == release_id:
        best = doc
if best is None:
    result = {
        "release": release_id,
        "state": "unknown",
        "status": "unknown",
        "reason": "ECS 上暂无该 release 的 DEPLOY_RESULT：可能仍在 fetch 阶段、"
                  "发射命令未被接受，或该 release 已被清理",
        "next_action": "稍后重跑 check；若刚发射过，重跑同一 publish 也是幂等安全的",
    }
else:
    status = str(best.get("status", ""))
    state = {
        "success": "success",
        "failed": "failed", "refused": "failed",
        "rolled_back": "failed", "rollback_failed": "failed", "busy": "failed",
        "in_progress": "checking",
    }.get(status, "unknown")
    result = {
        "release": release_id,
        "state": state,
        "status": status or "unknown",
        "commit": best.get("commit", ""),
        "phase": best.get("phase", ""),
        "production": best.get("production", {}),
        "previous": best.get("previous", {}),
        "error": best.get("error", ""),
        "next_action": best.get("next_action", ""),
        "failure_class": best.get("failure_class") or "",
        "updated_at": best.get("updated_at", ""),
    }
print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
PY
    exit 0
    ;;
  publish|rollback)
    # 只有 release 角色可以改动 production；dev/review 角色在这里被明确拒绝。
    trosa_require_release_role || exit 1
    mode=$cmd
    shift
    COMMIT=""
    RELEASE_ID=""
    ALLOW_DESTRUCTIVE=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --commit) [[ $# -ge 2 ]] || fail "--commit 需要一个值"; COMMIT=$2; shift 2 ;;
        --release-id) [[ $# -ge 2 ]] || fail "--release-id 需要一个值"; RELEASE_ID=$2; shift 2 ;;
        --allow-destructive-db) ALLOW_DESTRUCTIVE=1; shift ;;
        *) fail "未知参数：$1" ;;
      esac
    done
    if [[ "$mode" == "publish" ]]; then
      [[ -n "$COMMIT" ]] || fail "publish 需要 --commit（必须是已推送到 GitHub 的 commit）"
      [[ "$COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || fail "commit 必须是 40 位 SHA：$COMMIT"
      if ! git -C "$SOURCE_DIR" cat-file -e "$COMMIT" 2>/dev/null; then
        fail "本地仓库找不到 commit $COMMIT"
      fi
      if [[ -z "$RELEASE_ID" ]]; then
        RELEASE_ID="rel-$(date -u +%Y%m%d%H%M%S)-${COMMIT:0:12}"
      fi
    else
      # rollback 结果写入独立目录，不与任何代码 release 混淆。
      [[ -z "$RELEASE_ID" ]] && RELEASE_ID="rollback-$(date -u +%Y%m%d%H%M%S)"
      [[ -n "$COMMIT" ]] || COMMIT="$(git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')"
    fi
    case "$RELEASE_ID" in ''|*[!A-Za-z0-9._-]*) fail "非法 release id：$RELEASE_ID" ;; esac

    # trosa-operator 不能登录、不能获得通用 root shell；它只可 sudo 到 ECS
    # 上参数校验过的包装器。包装器下载并 detached 启动既有 release-remote.sh。
    launch="sudo /usr/local/lib/trosa/release-runner '$REMOTE_ROOT' '$SERVICE_NAME' '$RELEASE_ID' '$COMMIT' '$GITHUB_REMOTE' '$mode' '$ALLOW_DESTRUCTIVE'"
    launch_rc=0
    launch_out="$(ca_exec "$launch")" || launch_rc=$?
    if [[ "$launch_rc" != 0 ]]; then
      printf '%s\n' "$launch_out" >&2
      if [[ "$launch_rc" == 124 ]]; then
        # 发射命令已被 Cloud Assistant 接受（或接受与否无法排除），但结果
        # 未能确认：这是 unknown，不是发布失败。production 可能已变更。
        printf 'TROSA_RELEASE_STATE unknown\n'
        printf '发射已提交但结果未知（Cloud Assistant 轮询失败）。production 状态未知，请勿假定未变更。\n' >&2
        printf '先恢复查询：trosa-release check --release-id %s；重跑同一 %s 也是幂等安全的。\n' "$RELEASE_ID" "$mode" >&2
        exit 5
      fi
      fail "发射命令未成功执行（Cloud Assistant 提交被拒，或远端包装器校验失败）。production 未变更；可直接重跑"
    fi
    printf '%s\n' "$launch_out" | grep -q "launched $RELEASE_ID" || {
      printf '%s\n' "$launch_out" >&2
      fail "发射未确认。production 未变更；可直接重跑"
    }
    printf 'TROSA_RELEASE_STATE submitted\n'

    # 轮询：只读 cat 结果文件，单次调用都是短命令，可安全重试。
    # 任何一次轮询失败都只意味着"本次没问到"，不代表发布失败。
    # 轮询窗口要覆盖服务端等待发布锁的时间（默认 900s）。
    deadline=$((SECONDS + ${TRADE_OS_RELEASE_POLL_TIMEOUT:-1200}))
    poll_interval="${TRADE_OS_RELEASE_POLL_INTERVAL:-5}"
    last_status=""
    printf 'TROSA_RELEASE_STATE checking\n'
    while [[ $SECONDS -lt $deadline ]]; do
      sleep "$poll_interval"
      poll_out="$(ca_exec "cat '$REMOTE_ROOT/.last-deploy-result.json' 2>/dev/null; echo; cat '$REMOTE_ROOT/releases/$RELEASE_ID/DEPLOY_RESULT.json' 2>/dev/null" 2>/dev/null || true)"
      doc="$(printf '%s\n' "$poll_out" | python3 -c "
import json,sys
best=None
for line in sys.stdin.read().splitlines():
    line=line.strip()
    if not line.startswith('{'): continue
    try: d=json.loads(line)
    except Exception: continue
    if d.get('release')=='$RELEASE_ID': best=d
print(json.dumps(best) if best else '')" 2>/dev/null || true)"
      if [[ -z "$doc" ]]; then
        # runner 还没写出首个结果（仍在 fetch 阶段）；继续等。
        continue
      fi
      last_status="$(printf '%s' "$doc" | python3 -c "import json,sys;print(json.load(sys.stdin).get('status',''))" 2>/dev/null || true)"
      if [[ "$last_status" != "in_progress" && -n "$last_status" ]]; then
        printf '%s\n' "$doc" | python3 -m json.tool
        printf 'TROSA_RELEASE_STATE %s\n' "$(release_state_for "$last_status")"
        # Explicit failure class: backup_failed / backup_verification_failed /
        # release_failed / release_refused / release_busy. (A local download
        # failure is client-side and never reaches the server result.)
        failure_class="$(printf '%s' "$doc" | python3 -c "import json,sys;print(json.load(sys.stdin).get('failure_class') or '')" 2>/dev/null || true)"
        if [[ -n "$failure_class" ]]; then
          printf 'TROSA_RELEASE_FAILURE_CLASS %s\n' "$failure_class"
        fi
        case "$last_status" in
          success) printf 'TROSA_RELEASE_SUCCESS release=%s\n' "$RELEASE_ID"; exit 0 ;;
          refused)
            printf 'TROSA_RELEASE_REFUSED release=%s（production 未变更，见 next_action）\n' "$RELEASE_ID" >&2; exit 3 ;;
          rolled_back)
            printf 'TROSA_RELEASE_ROLLED_BACK release=%s（已自动恢复上一健康版本，见 next_action）\n' "$RELEASE_ID" >&2; exit 4 ;;
          busy)
            printf 'TROSA_RELEASE_BUSY release=%s（另一个发布仍占用 ECS 锁，本次未改动 production；稍后重跑同一 publish 即可）\n' "$RELEASE_ID" >&2; exit 6 ;;
          *) printf 'TROSA_RELEASE_FAILED release=%s status=%s（见 error/next_action）\n' "$RELEASE_ID" "$last_status" >&2; exit 1 ;;
        esac
      fi
    done
    printf 'TROSA_RELEASE_STATE unknown\n'
    printf '轮询超时。release %s 仍在服务端执行或结果不可读。\n' "$RELEASE_ID" >&2
    printf 'production 状态未知但服务端任务不受本机影响：先 trosa-release check --release-id %s 恢复查询，或重跑同一 %s（幂等）。\n' "$RELEASE_ID" "$mode" >&2
    exit 5
    ;;
  ""|--help|-h|help)
    usage
    ;;
  *)
    fail "未知命令：$cmd（可用：publish / status / rollback / db-plan）"
    ;;
esac
