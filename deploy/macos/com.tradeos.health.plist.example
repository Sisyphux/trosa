<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradeos.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/luoxin/Library/Application Support/TradeOS/check-and-repair.sh</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/luoxin/Library/Application Support/TradeOS</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/luoxin/Library/Application Support/TradeOS/logs/health-launchagent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/luoxin/Library/Application Support/TradeOS/logs/health-launchagent-error.log</string>
</dict>
</plist>
