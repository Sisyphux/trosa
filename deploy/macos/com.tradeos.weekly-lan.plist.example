<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradeos.weekly-lan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/luoxin/Library/Application Support/TradeOS/run-weekly-lan.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/luoxin/Library/Application Support/TradeOS/logs/weekly-lan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/luoxin/Library/Application Support/TradeOS/logs/weekly-lan-error.log</string>
</dict>
</plist>
