# Private production settings. Install as ~/Library/Application Support/TradeOS/env.production and keep mode 600.
CRM_ENV=production
CRM_SESSION_SECRET=replace_with_a_random_48_character_secret
CRM_SESSION_HOURS=720
# Each member creates a personal six-digit access code on their first entry.
# The code is stored only as a password hash in system.db; do not add it here.
CRM_PUBLIC_URL=https://app.trosa.space
CRM_DB_PATH="/Users/luoxin/Library/Application Support/TradeOS/runtime/data"
CRM_PORT=8080
CRM_THREADS=8
# 生产服务同时接受 Cloudflare Tunnel（本机回环）和公司局域网访问。
CRM_BIND_HOST=0.0.0.0
# 只允许公司局域网免密进入只读周报；不要填写 VPN 出口或公网网段。
# 当前办公室网卡为 192.168.0.58/23，因此覆盖 192.168.0.x / 192.168.1.x。
CRM_INTERNAL_VIEWER_CIDRS=192.168.0.0/23
