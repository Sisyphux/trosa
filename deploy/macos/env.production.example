# Private recovery settings. Install as ~/Library/Application Support/TradeOS/env.production and keep mode 600.
# This file is not a second data plane: any approved Mac recovery service must
# connect to the authoritative PostgreSQL instance through a private loopback
# tunnel before serve.py is allowed to start.
CRM_ENV=production
CRM_SESSION_SECRET=replace_with_a_random_48_character_secret
CRM_SESSION_HOURS=720
# Each member creates a personal six-digit access code on their first entry.
# The code is stored only as a password hash in PostgreSQL; do not add it here.
CRM_PUBLIC_URL=https://app.trosa.space
# Use the approved SSH/tunnel port for the authoritative PostgreSQL database;
# never replace this with a local SQLite path or a second PostgreSQL database.
TRADE_OS_DATA_BACKEND=postgres
TRADE_OS_DATABASE_URL=postgresql://tradeos_app@127.0.0.1:15432/tradeos
PGPASSFILE="/Users/luoxin/Library/Application Support/TradeOS/postgres.pgpass"
# Attachments/import sources/rollback materials only; formal business facts
# remain in PostgreSQL.
CRM_DB_PATH="/Users/luoxin/Library/Application Support/TradeOS/runtime/data"
CRM_PORT=8080
CRM_THREADS=8
# Only bind the recovery listener locally; expose it through the approved
# private tunnel or reverse proxy, never by opening a public port.
CRM_BIND_HOST=127.0.0.1
