# ===== Trade OS 可选配置模板 =====
# 核心 CRM 无需模型密钥。仅在启用相应辅助模块时填写第三方配置。
# 复制本文件为 .env，然后按需填写。
# cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交，可安全填写真实 Key。
# 修改环境文件后需重启应用才生效；也可以登录「设置 → AI API 快速接入」即时保存。
# 设置页写入独立的权限文件：默认是 CRM_DB_PATH/ai-config.env（文件权限 600），
# 不写入 SQLite 客户数据库；如需指定位置，可设置 CRM_AI_CONFIG_FILE=/path/to/ai-config.env。

# --- 正式线上运行必填 ---
# CRM_ENV=production
# 正式入口 serve.py 只接受 PostgreSQL；缺少以下两项会在启动前失败，不会回退 SQLite。
# TRADE_OS_DATA_BACKEND=postgres
# TRADE_OS_DATABASE_URL=postgresql://tradeos_app@127.0.0.1:5432/tradeos
# PGPASSFILE=/etc/trade-os/postgres.pgpass
# 使用 `python3 -c "import secrets; print(secrets.token_urlsafe(48))"` 生成。
# CRM_SESSION_SECRET=
# 已登录设备默认记住 30 天；可按需缩短。
# CRM_SESSION_HOURS=720
# 生产环境要求每位用户拥有不同的 6 位数字访问码。访问码首次由用户在登录页设置，
# 之后只以哈希形式保存到 PostgreSQL 身份表，不要把明文访问码写入环境文件。
# 隔离开发可使用 SQLite，但必须显式设置 CRM_ENV=development 与
# TRADE_OS_DEV_SQLITE=1；它不是正式业务运行方式。
# CRM_MAX_UPLOAD_MB=25
# CRM_PUBLIC_URL=https://trade.example.com
# 正式服务的 CRM_DB_PATH 仅存附件、导入来源和回滚材料，不是业务数据库目录。
# CRM_DB_PATH=/var/lib/trade-os
# Production CORS is limited to CRM_PUBLIC_URL plus these explicit extension
# origins. Keep this empty unless the browser extension is used remotely.
# CRM_CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# Cloud servers do not have the local browser-tools/Chrome fallback.
# CRM_BROWSER_TOOLS_ENABLED=0
# Optional office-LAN, read-only meeting view. The production listener must
# also set CRM_BIND_HOST=0.0.0.0. Use only private office CIDRs; never add VPN
# exit IPs or public ranges. Keep the router free of port forwarding.
# CRM_BIND_HOST=0.0.0.0
# CRM_INTERNAL_VIEWER_CIDRS=192.168.0.0/23
# Set to 1 only when this app is explicitly allowed to stop another process on port 8080.
# CRM_ALLOW_PORT_TAKEOVER=0
# Development/demo only. Normal first launch keeps every user database empty.
# CRM_SEED_DEMO_DATA=false

# --- 可选：DeepSeek ---
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=

# --- 可选：Exa MCP 官网公开摘要 ---
# 通过匿名 Exa MCP 端点读取公开摘要，无需搜索 API key；Codex 端点配置位于 ~/.codex/config.toml。
# 设为 0 可关闭动态页面的 browser-tools 回退；默认自动尝试已安装 Skill。
# CRM_BROWSER_TOOLS_ENABLED=1
# 如 Skill 不在 ~/.codex/skills/browser-tools，可填写绝对路径。
# CRM_BROWSER_TOOLS_DIR=

# --- 可选：通义千问（阿里 DashScope）---
# DASHSCOPE_API_KEY=

# --- 可选：智谱 GLM ---
# ZHIPU_API_KEY=

# --- 可选：OpenAI ---
# OPENAI_API_KEY=

# --- 指定所有 AI 功能共用的后端（默认 auto）---
# 可选值：deepseek / qwen / glm / openai / lmstudio / ollama / auto
# LLM_BACKEND=deepseek

# --- Gmail 沟通自动读取（可选）---
# 在 Google Cloud Console 创建 Web application OAuth client，启用 Gmail API，
# 并将下方完整回调地址加入 Authorized redirect URIs。仅请求 gmail.readonly，
# 不会发送、删除或修改 Gmail 邮件。
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=https://app.trosa.space/api/integrations/gmail/oauth/callback
# 用至少 32 个随机字符保护本地加密的 refresh token；推荐使用独立值。
# 不设置时会回退使用 CRM_SESSION_SECRET（生产环境同样必须为高强度随机值）。
# GMAIL_TOKEN_ENCRYPTION_KEY=
# 已连接账号每 5 分钟检查一次 Gmail；仅已连接的个人账号会被读取。
# GMAIL_SYNC_ENABLED=true
# GMAIL_SYNC_INTERVAL_SECONDS=300
# 首次连接只读取最近 90 天；大邮箱会分批继续，避免阻塞核心 CRM。
# GMAIL_INITIAL_LOOKBACK_DAYS=90
# GMAIL_INITIAL_MAX_MESSAGES=100
# GMAIL_SYNC_MAX_MESSAGES=100
# 每轮最多调用现有 AI 沟通整理 20 次；其余邮件仍会用原文摘要入库。
# GMAIL_AI_SUMMARIZE=true
# GMAIL_AI_MAX_SUMMARIES_PER_SYNC=20

# --- 自建邮箱可发送性 SMTP 探测（默认关闭）---
# 需要固定公网 IP、PTR、可正向解析的 EHLO 主机名，以及可接收退信的专用邮箱。
# 不使用第三方邮箱验证 API；worker 只执行 EHLO / MAIL FROM / RCPT TO，绝不发送 DATA。
# EMAIL_VERIFY_SMTP_ENABLED=false
# EMAIL_VERIFY_HELO_HOST=verifier.example.com
# EMAIL_VERIFY_MAIL_FROM=verify@verifier.example.com
# EMAIL_VERIFY_SMTP_TIMEOUT=8
# EMAIL_VERIFY_SMTP_MAX_MX=2
#
# Catch-all 探测按域名缓存。开启前请设置高强度随机密钥；默认关闭。
# EMAIL_VERIFY_CATCHALL_ENABLED=false
# EMAIL_VERIFY_CATCHALL_SECRET=
# EMAIL_VERIFY_DOMAIN_CACHE_DAYS=7
# EMAIL_VERIFY_JOB_INTERVAL=30
